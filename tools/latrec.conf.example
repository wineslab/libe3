# Deployment settings, sourced by `latrec.sh on`.
#
# Copy to latrec.conf beside latrec.sh, or point LATREC_CONF at it. Nothing here
# is required. Assign with ${VAR:-default} so a value already in the environment
# wins.
#
# SPDX-License-Identifier: LicenseRef-CSSL-1.0

# ---- ring capacity -------------------------------------------------------
# LATREC_ENTRIES_LOG2_<ROLE> sets one role's ring to 2^N records of 32 bytes.
# ROLE is the ring name uppercased, non-alphanumerics as '_', so the ring
# oai.mac is OAI_MAC. Each increment doubles the file, pre-allocated at open.
# `latrec.sh report` prints which rings wrapped.
#
# Example, an OAI gNB whose MAC stamps every slot rather than every UL slot:
# export LATREC_ENTRIES_LOG2_OAI_MAC="${LATREC_ENTRIES_LOG2_OAI_MAC:-24}"

# ---- conversion ----------------------------------------------------------
# CPU list for the conversion. Unset means no pinning; an unusable list falls
# back to unpinned.
# export LATREC_CPUS="${LATREC_CPUS:-27,28,29,30}"

# ---- unattended conversion ----------------------------------------------
# `watch` converts once the rings have been idle for LATREC_QUIET_SECS. Listing
# processes here makes it also wait for them to exit.
#
# Patterns go to `pgrep -f`, so bracket one character to keep a pattern from
# matching the watcher's own command line: 'bin/subcarrier[_]power'.
#
# Example, the SPEAR stack:
# export LATREC_WATCH_PROCS="${LATREC_WATCH_PROCS:-nr-softmodem nearRT-RIC xapp_spectrum bin/subcarrier[_]power spectrum[_]dapp.py}"

# export LATREC_QUIET_SECS="${LATREC_QUIET_SECS:-15}"
# export LATREC_WATCH_TIMEOUT="${LATREC_WATCH_TIMEOUT:-7200}"
