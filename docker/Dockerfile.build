# Builds libe3, the examples, the integration tests and the latency benchmark
# with every encoding and SCTP. The other images copy their binaries from it.
# DEPS_IMAGE is the image of Dockerfile.deps.
#
#   docker build -f docker/Dockerfile.deps  -t libe3-deps:local .
#   docker build -f docker/Dockerfile.build -t libe3-build:local .

ARG DEPS_IMAGE=libe3-deps:local
FROM ${DEPS_IMAGE}
COPY . /src
RUN ./build_libe3 -r --all-encodings --enable-sctp \
    --cmake-opt "-DLIBE3_BUILD_INTEGRATION_TESTS=ON -DLIBE3_ENABLE_LATREC=ON"
# Lets the cluster stage run the tests as an unprivileged user.
RUN chmod -R a+rwX /src/build
